# Local portfolio defaults. Change the password consistently before starting.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
# For a backend running on the host:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:55432/ecommerce_recommendations
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Native launcher: export these in your shell when overriding defaults.
# ./scripts/local.sh supplies its own DATABASE_URL and generated credentials.
# LOCAL_API_PORT=8000
# LOCAL_PG_PORT=55433
# LOCAL_PG_BIN=/Applications/Postgres.app/Contents/Versions/16/bin
# LOCAL_RUNTIME_DIR=/path/to/a/dedicated/local-runtime
# LOCAL_PYTHON=/path/to/a/Python-3.14-venv/bin/python
